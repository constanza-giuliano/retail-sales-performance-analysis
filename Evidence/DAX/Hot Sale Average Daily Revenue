Hot Sale Average Daily Revenue =
(
    CALCULATE(
        SUM(Sales[Total Revenue]),
        VAR StartDate = "05/10/2019"
        VAR EndDate = "05/20/2019"
        RETURN
            DATESBETWEEN(
                Calendar[Date],
                StartDate,
                EndDate
            )
    )
)
/
(
    VAR StartDate = "05/10/2019"
    VAR EndDate = "05/20/2019"
    RETURN
        DATEDIFF(StartDate, EndDate, DAY)
)
